
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
ACCESS_TOKEN_SECRET=
LOCAL_PATH=

SMTP_EMAIL=
SMTP_PASSWORD=


# SMS CRED
SMSCUSTOMERID=
SMS_EMAIL_ID=
SMS_KEY=


ISLOCAL=

LOCAL=

SOCKET_PORT=

# number of server worker processes (default: one per CPU). 2 is plenty for local dev and makes restarts fast
CLUSTER_WORKERS=

# Lead CRM
# long random string used to encrypt integration keys (e.g. IndiaMART CRM key)
INTEGRATION_ENCRYPTION_KEY=
# public URL of this API incl. /api, used to show webhook URLs (e.g. https://api.yourdomain.com/api)
PUBLIC_API_URL=
# set to true to stop the IndiaMART sync job
DISABLE_SCHEDULER=
# fallback student portal URL when an agency has no domain set (e.g. https://portal.yourdomain.com)
STUDENT_PORTAL_URL=
# base domain for platform-hosted agency subdomains (e.g. techxsolutions.io → agency.techxsolutions.io)
PLATFORM_PORTAL_DOMAIN=techxsolutions.io

# Meta (Facebook / Instagram Lead Ads + WhatsApp) - see docs/META_SETUP.md
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v21.0

# SaaS billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# shown to agencies on the renew screen
SAAS_SUPPORT_PHONE=
SAAS_SUPPORT_EMAIL=
# platform admin: gets an email when an agency payment fails (comma separated)
SAAS_ADMIN_EMAIL=
# WhatsApp number agencies can reach support on (Help button in the agency panel), e.g. 919876543210
SAAS_SUPPORT_PHONE=

# signs private document links (falls back to ACCESS_TOKEN_SECRET)
FILE_SIGNING_KEY=

# Notifications email (SMTP_EMAIL / SMTP_PASSWORD above). Optional custom SMTP:
SMTP_HOST=
SMTP_PORT=
MAIL_FROM_NAME=
# agency panel address, used for "Open in CRM" links in emails
AGENCY_PANEL_URL=

# Resend (https://resend.com) - when set, email goes through Resend instead of SMTP_* above.
# Used for agency login codes, CRM notifications, and student portal invite emails.
# MAIL_FROM must be on a domain you verified in Resend: an address (no-reply@yourdomain.com) or just the domain (sends from no-reply@)
RESEND_API_KEY=
MAIL_FROM=

# AWS S3 file storage - see docs/S3_SETUP.md
# When AWS_S3_BUCKET is set, every upload (documents, images, videos, reports) goes to S3 in a
# folder per agency: agencies/<agency_uuid>/<folder>/... (admin uploads go to platform/<folder>/...).
# Leave empty to keep files on local disk.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
# leave both empty on EC2 with an instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# optional: CloudFront (or other CDN) domain in front of the bucket, for direct public image links
AWS_S3_PUBLIC_URL=
